# === API Keys ===

# 智谱AI API密钥（必填，用于文档向量化和问题向量检索）
ZHIPUAI_API_KEY=

# MiMo API密钥（必填，用于多模态 LLM 生成回答）
MIMO_API_KEY=

# === 质量验证客户端 ===

# scripts/verify_quality.py 调用启用鉴权的 API 时使用；不要提交真实值。
# 自动化优先由秘密管理系统注入 QUALITY_API_KEY，交互运行可使用 --api-key-file。
QUALITY_API_KEY=
# QUALITY_API_KEY_FILE=C:/secure/quality-api.key

# === PDF 知识生产 ===

# 项目解析后端名。运行已构建知识包时不会调用该后端
PDF_PARSER_BACKEND=mineru

# 当前唯一验证过的外部实现来自 requirements-parser.txt
MINERU_BIN=magic-pdf
MINERU_ARGS=

# strict 默认拒绝未经验证的实现/版本；allow-unverified 只用于隔离迁移试验
MINERU_COMPATIBILITY_POLICY=strict

# === 可选配置 ===

# MiMo API 地址（可选，默认 https://api.xiaomimimo.com/v1）
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# MiMo 模型名称（可选，默认 mimo-v2.5）
MIMO_MODEL=mimo-v2.5

# LLM 请求超时时间，单位秒，必须大于 0（可选，默认 180）
LLM_TIMEOUT_SECONDS=180

# RAG 检索返回的文档数量，取值 1-100（可选，默认 12）
RAG_TOP_K=12

# 图片加载相关性阈值，距离越小越相关，不能为负数（可选，默认 0.65）
RAG_MIN_SCORE=0.65

# Embedding 模型名称（可选，默认 embedding-2）
EMBEDDING_MODEL=embedding-2

# 检索融合权重（阶段三：dense + BM25 + 条文号精确匹配）
RETRIEVAL_DENSE_WEIGHT=1.0
RETRIEVAL_BM25_WEIGHT=0.18
RETRIEVAL_CLAUSE_BOOST=5.0

# Reranker 仅预留扩展点，当前没有可用实现，必须保持关闭
RERANK_ENABLED=false
RERANK_PROVIDER=none

# 统一运行数据根（可选，默认 ./data；相对路径按项目根目录解析）
DATA_DIR=./data

# 无 active_db.json 时的旧数据库回退目录（可选，默认 ./db）
DB_DIR=./db

# 图片和来源策略默认跟随 DATA_DIR；只有独立存储时才取消注释覆盖
# IMG_DIR=./data/images
IMG_BASE_URL=/images
# SOURCE_METADATA_PATH=./data/metadata/specs.json

# 静态页面目录（可选，默认 frontend/dist；运行前执行 frontend 的 npm run build）
STATIC_DIR=./frontend/dist

# 对外提供页面截图时使用的公共资源前缀（可选；留空时使用相对 /images）
PUBLIC_ASSET_BASE_URL=

# API 鉴权。默认关闭；公网部署必须开启。开启时 API_KEYS 不能为空或使用示例占位值
API_AUTH_ENABLED=false
API_KEYS=

# API 鉴权开启时必填。使用独立、随机且至少 32 字符的密钥签发短期图片 URL
ASSET_SIGNING_KEY=
ASSET_URL_TTL_SECONDS=3600

# Open WebUI 连接本 API 时使用的单个 Key；启用 API 鉴权时必须与 API_KEYS 中的一项一致
OPENWEBUI_API_KEY=

# 请求保护。字节数必须大于 0；启用限流时每分钟配额必须大于 0
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
JOB_HEARTBEAT_SECONDS=15
JOB_STALE_AFTER_SECONDS=7200

# API 后台任务执行回答盲测时访问本服务的受信任内部地址。
# 自定义监听端口或容器网络地址时必须同步修改；管理接口不接受客户端覆盖该地址
ANSWER_EVALUATION_API_BASE=http://127.0.0.1:8000

# 知识版本保留策略。活动、运行中、人工固定、近期回滚和最短保护期版本不会被删除
VERSION_RETENTION_KEEP_RECENT_PASSED=2
VERSION_RETENTION_SUCCESS_DAYS=30
VERSION_RETENTION_FAILED_DAYS=7
VERSION_RETENTION_MINIMUM_AGE_HOURS=24
VERSION_RETENTION_HIGH_WATERMARK_BYTES=21474836480
VERSION_RETENTION_LOW_WATERMARK_BYTES=17179869184
VERSION_RETENTION_PLAN_TTL_MINUTES=15

# CORS 设置。生产环境应改为明确域名；允许凭据时不能使用通配符来源
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=false

# 日志等级：DEBUG、INFO、WARNING、ERROR 或 CRITICAL
LOG_LEVEL=INFO

# API 日志格式：json（容器/采集默认）或 text（本地人工阅读）
LOG_FORMAT=json
