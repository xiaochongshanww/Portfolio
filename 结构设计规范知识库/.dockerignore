# Default deny: only inputs explicitly consumed by Dockerfile may enter the context.
**

!Dockerfile
!.dockerignore
!requirements-runtime.txt

!src/
!src/**

!frontend/
!frontend/**
frontend/node_modules/
frontend/dist/
frontend/.env*
frontend/coverage/
frontend/.vite/
frontend/.turbo/

!data/
!data/evaluation/
!data/evaluation/**
!data/metadata/
!data/metadata/**

**/__pycache__/
**/*.pyc
