    {
      "case": "主要受力结构",
      "formula_latex": "w_k = \\beta_z \\mu_s \\mu_z w_0",
      "formula_text": "风荷载标准值 = 高度z处风振系数 × 风荷载体型系数 × 风压高度变化系数 × 基本风压",
      "variables": [
        "w_k：风荷载标准值，单位kN/m²",
        "β_z：高度z处的风振系数",
        "μ_s：风荷载体型系数",
        "μ_z：风压高度变化系数",
        "w_0：基本风压，单位kN/m²"
      ],
      "condition": "计算主要受力结构时，风荷载标准值按8.1.1-1公式计算。",
      "aliases": ["主要受力结构", "主体结构", "风荷载标准值", "风荷载计算公式", "风振系数", "体型系数", "风压高度变化系数", "基本风压", "w_k", "beta_z", "mu_s", "mu_z", "w_0"]
    },
    {
      "case": "围护结构",
      "formula_latex": "w_k = \\beta_g \\mu_{sl} \\mu_z w_0",
      "formula_text": "风荷载标准值 = 高度z处阵风系数 × 风荷载局部体型系数 × 风压高度变化系数 × 基本风压",
      "variables": [
