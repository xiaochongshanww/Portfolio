      ],
      "condition": "计算围护结构时，风荷载标准值按8.1.1-2公式计算。",
      "aliases": ["围护结构", "幕墙", "围护构件", "风荷载标准值", "围护结构风荷载", "阵风系数", "局部体型系数", "风压高度变化系数", "基本风压", "w_k", "beta_g", "mu_sl", "mu_z", "w_0"]
