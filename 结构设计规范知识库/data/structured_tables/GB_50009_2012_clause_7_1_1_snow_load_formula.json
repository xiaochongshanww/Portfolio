    {
      "applies_to": "屋面水平投影面上的雪荷载标准值",
      "formula_latex": "s_k = \\mu_r s_0",
      "formula_text": "雪荷载标准值 = 屋面积雪分布系数 × 基本雪压",
      "variables": [
        "s_k：雪荷载标准值，单位kN/m²",
        "μ_r：屋面积雪分布系数",
        "s_0：基本雪压，单位kN/m²"
      ],
      "condition": "屋面水平投影面上的雪荷载标准值按7.1.1公式计算。",
      "aliases": ["雪荷载标准值", "雪荷载公式", "雪荷载计算公式", "屋面雪荷载", "基本雪压", "屋面积雪分布系数", "s_k", "mu_r", "s_0"]
